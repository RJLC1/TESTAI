<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <label>Onboarding Kickoff 7-Day Reminder</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <start>
        <object>Onboarding__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-08-01</startDate>
            <startTime>08:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Kickoff Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Kickoff_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Implementation_Owner__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
    </start>

    <formulas>
        <name>fxDaysUntilKickoff</name>
        <dataType>Number</dataType>
        <scale>0</scale>
        <expression>{!$Record.Kickoff_Date__c} - TODAY()</expression>
    </formulas>

    <decisions>
        <name>Check_Within_7_Days</name>
        <label>Check Within 7 Days</label>
        <locationX>176</locationX>
        <locationY>100</locationY>
        <defaultConnectorLabel>Not Within Window</defaultConnectorLabel>
        <rules>
            <name>Is_Approaching</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxDaysUntilKickoff</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fxDaysUntilKickoff</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>7</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Custom_Notification_Type</targetReference>
            </connector>
            <label>Is Approaching</label>
        </rules>
    </decisions>

    <recordLookups>
        <name>Get_Custom_Notification_Type</name>
        <label>Get Custom Notification Type</label>
        <locationX>300</locationX>
        <locationY>200</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Recipient_IDs</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Kickoff_Meeting_Reminder</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>CustomNotificationType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <assignments>
        <name>Assign_Recipient_IDs</name>
        <label>Assign Recipient IDs</label>
        <locationX>300</locationX>
        <locationY>320</locationY>
        <assignmentItems>
            <assignToReference>varRecipientIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Implementation_Owner__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Kickoff_Reminder_Notification</targetReference>
        </connector>
    </assignments>

    <actionCalls>
        <name>Send_Kickoff_Reminder_Notification</name>
        <label>Send Kickoff Reminder Notification</label>
        <locationX>300</locationX>
        <locationY>440</locationY>
        <actionName>customNotificationAction</actionName>
        <actionType>customNotificationAction</actionType>
        <inputParameters>
            <name>customNotifTypeId</name>
            <value>
                <elementReference>Get_Custom_Notification_Type.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>body</name>
            <value>
                <stringValue>The kickoff meeting for {!$Record.Customer_Name__c} is scheduled in {!fxDaysUntilKickoff} days ({!$Record.Kickoff_Date__c}). Please ensure kickoff preparation tasks are completed.</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>title</name>
            <value>
                <stringValue>Kickoff Meeting Approaching</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientIds</name>
            <value>
                <elementReference>varRecipientIds</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>targetId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
    </actionCalls>

    <variables>
        <name>varRecipientIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>